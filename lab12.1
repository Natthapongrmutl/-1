#include <stdio.h>
#include <stdlib.h>

int* Dijkstra(int *graph, int nodeCount);
void initializeGraph(int *graph, int nodeCount);
void printResult(int *distance, int nodeCount);

int main()
{
    int nodeCount = 5;
    int *graph;
    int *distance;

    graph = new int[nodeCount * nodeCount];

    initializeGraph(graph, nodeCount);

    distance = Dijkstra(graph, nodeCount);

    printResult(distance, nodeCount);

    return 0;
}

void initializeGraph(int *graph, int nodeCount)
{
    int row;
    int col;

    for(row = 0; row < nodeCount; row++)
    {
        for(col = 0; col < nodeCount; col++)
        {
            graph[row * nodeCount + col] = -1;
        }
    }

    graph[0 * nodeCount + 1] = 100;
    graph[0 * nodeCount + 2] = 80;
    graph[0 * nodeCount + 3] = 30;
    graph[0 * nodeCount + 4] = 10;

    graph[1 * nodeCount + 2] = 20;

    graph[3 * nodeCount + 1] = 20;
    graph[3 * nodeCount + 2] = 20;

    graph[4 * nodeCount + 3] = 10;
}

int* Dijkstra(int *graph, int nodeCount)
{
    int *distance = new int[nodeCount];
    int *visited = new int[nodeCount];

    int i;
    int j;

    for(i = 0; i < nodeCount; i++)
    {
        distance[i] = -1;
        visited[i] = 0;
    }

    distance[0] = 0;

    for(i = 0; i < nodeCount; i++)
    {
        int currentNode = -1;
        int minDistance = -1;

        for(j = 0; j < nodeCount; j++)
        {
            if(visited[j] == 0 && distance[j] != -1)
            {
                if(minDistance == -1 || distance[j] < minDistance)
                {
                    minDistance = distance[j];
                    currentNode = j;
                }
            }
        }

        if(currentNode == -1)
        {
            break;
        }

        visited[currentNode] = 1;

        for(j = 0; j < nodeCount; j++)
        {
            if(graph[currentNode * nodeCount + j] != -1)
            {
                int newDistance =
                    distance[currentNode] +
                    graph[currentNode * nodeCount + j];

                if(distance[j] == -1 || newDistance < distance[j])
                {
                    distance[j] = newDistance;
                }
            }
        }
    }

    return distance;
}

void printResult(int *distance, int nodeCount)
{
    int i;

    for(i = 0; i < nodeCount - 1; i++)
    {
        printf("%d ", distance[i]);
    }

    printf("\n");
}
